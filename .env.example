# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=9080
DEBUG=false
ENVIRONMENT=development

# MySQL Database (vibe_music with tb_* tables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=vibe_music
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Redis Cache (Database 1 as configured in Spring Boot)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=root
REDIS_DB=1

# MinIO Object Storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=vibe-music-data
MINIO_PUBLIC_URL=http://localhost:9000

# JWT Security Contract (Frozen in Milestone 0)
JWT_SECRET_KEY=SIMPLE_MUSIC
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600
REDIS_TOKEN_EXPIRE_SECONDS=21600
